root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# shfmt reads these keys, so they must match its default output (tabs).
[*.{sh,bash,zsh}]
indent_style = tab

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2
