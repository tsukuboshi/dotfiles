	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bash ~/dotfiles/genai/hooks/pre-commit-fmt.sh"
					}
				]
			},
			{
				"matcher": "mcp__claude-in-chrome__computer|mcp__claude-in-chrome__javascript_tool",
				"hooks": [
					{
						"type": "command",
						"command": "bash ~/dotfiles/genai/hooks/chrome-tool-guard.sh"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash ~/dotfiles/genai/hooks/post-edit-fmt.sh"
					}
				]
			}
		],
		"Stop": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "bash ~/dotfiles/genai/hooks/stop-notify.sh"
					}
				]
			}
		],
		"ConfigChange": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "bash ~/dotfiles/genai/hooks/config-change-guard.sh"
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "^(startup|resume|clear|compact|fork)$",
				"hooks": [
					{
						"type": "command",
						"command": "bash ~/dotfiles/genai/hooks/herdr-agent-state.sh session",
						"timeout": 10
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash ~/dotfiles/genai/hooks/herdr-tab-title.sh",
						"timeout": 5
					}
				]
			}
		]
	},
	"statusLine": {
		"type": "command",
		"command": "zsh ~/dotfiles/genai/statusline/render.sh",
		"refreshInterval": 60
	},
	"enabledPlugins": {
