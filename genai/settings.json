	"language": "Japanese",
	"sandbox": {
		"enabled": false,
		"allowUnsandboxedCommands": true,
		"network": {
			"allowedDomains": [
				"github.com",
				"api.github.com",
				"registry.npmjs.org",
				"pypi.org",
				"files.pythonhosted.org"
			]
		},
		"filesystem": {
			"allowWrite": ["/tmp"],
			"denyWrite": ["~/.bashrc", "~/.zshrc", "~/.ssh"],
			"denyRead": [
				"./.env",
				"./secrets",
				"./config/credentials.json",
				"./build",
				"~/.ssh",
				"~/.aws/credentials"
			]
		},
		"excludedCommands": ["open"]
	},
	"askUserQuestionTimeout": "10m",
	"remoteControlAtStartup": true,
	"agentPushNotifEnabled": true,
	"skipAutoPermissionPrompt": true
